# Amazon PL Hunter v2 — environment template. Copy to .env; never commit real values.
# Server
PLH_API_TOKEN=
PLH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
PLH_LOG_LEVEL=INFO
# Database (optional override; default is data/plhunter.db)
PLH_DATABASE_URL=
# Live hunting gate: set to 1 ONLY when you intentionally want live Amazon scraping.
# Dry-run is the default and needs no flag.
PLH_LIVE=0
# Brevo transactional email (run summaries). If unset, summaries are written
# to data/run_summaries/<run_id>.html and email_status=skipped.
BREVO_API_KEY=
BREVO_SENDER=
BREVO_RECEIVER=
# SerpApi live mode (see README "SerpApi live mode"). When SERPAPI_API_KEY is
# set, live runs use SerpApi instead of direct Amazon scraping (direct
# scraping is blocked from this VM's egress). When unset, live runs use
# direct scraping (works from Jack's own machine). No key = $0, dry-run only.
SERPAPI_API_KEY=
SERPAPI_MAX_SEARCHES_PER_RUN=120
SERPAPI_MAX_PRODUCTS_PER_RUN=60
# Lead batch email (see README "Lead batch emails"): new live leads are only
# emailed once this many unsent ones have accumulated, as one CSV attachment.
# Run summaries are always written locally and never emailed per-run.
PLH_BATCH_MIN_LEADS=100
